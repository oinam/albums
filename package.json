{
  "name": "albums-oinam-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A static photo, video, and audio album that runs entirely on Cloudflare.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "ingest": "tsx scripts/ingest.ts",
    "describe": "tsx scripts/describe.ts",
    "docs": "ovellum build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.0.11",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "exifr": "^7.1.3",
    "ovellum": "^0.25.0",
    "prettier": "^3.4.2",
    "sharp": "^0.35.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "zod": "^4.5.2"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
