# Copy to `mise.local.toml` (gitignored), fill in, and run `mise trust` once. Mise then loads
# these into the project env, so `mise run ingest` sees them with no separate .env file. (Your shell already runs `mise activate`, so entering the repo loads them.)
#
#   cp mise.local.toml.example mise.local.toml
#   # edit the values below, then:
#   mise trust
#
# LOCAL DEV ONLY. Nothing here is needed to build the site — `npm run build` reads only the
# repository, which is why Cloudflare Pages can build with no secrets configured at all.

[env]

# ---------------------------------------------------------------------------------------------
# R2 — where the originals live.
#
# https://dash.cloudflare.com → R2 → Manage API tokens → Create token:
#   Object Read & Write, scoped to this one bucket.
# Account ID is on the R2 overview page.
R2_ACCOUNT_ID = ""
R2_ACCESS_KEY_ID = ""
R2_SECRET_ACCESS_KEY = ""
R2_BUCKET = ""

# ---------------------------------------------------------------------------------------------
# Where unprocessed originals are staged before upload. Defaults to _incoming/ inside the repo,
# which is convenient but sits in the blast radius of `git clean -xdf` — that command deletes
# ignored directories, and this one is ignored. Point it somewhere outside the repository and
# the originals stop depending on the repository surviving.
#
#   ALBUMS_STAGING = "/Users/brajeshwar/Pictures/oinam-albums"
ALBUMS_STAGING = ""

# Only for a bucket created under a JURISDICTION rather than a location hint. A jurisdictional
# bucket is reachable *only* through its own endpoint — <account>.eu.r2.cloudflarestorage.com
# rather than <account>.r2.cloudflarestorage.com — and uploads fail with NoSuchBucket against
# the wrong one. Leave empty unless the bucket page shows a jurisdiction.
#
# Either form works: the short code ("eu") or the whole S3 endpoint URL exactly as the
# dashboard shows it ("https://<account>.eu.r2.cloudflarestorage.com").
R2_JURISDICTION = ""
